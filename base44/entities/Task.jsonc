{
  "name": "Task",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title",
      "description": "Short task title",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "title": "Description",
      "description": "Optional details about the task",
      "default": ""
    },
    "stage": {
      "type": "string",
      "title": "Stage",
      "description": "Kanban column the task is in",
      "enum": [
        "backlog",
        "todo",
        "in_progress",
        "done"
      ],
      "default": "backlog"
    },
    "priority": {
      "type": "string",
      "title": "Priority",
      "description": "Task priority level",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "title": "Due Date",
      "description": "Optional due date"
    },
    "order": {
      "type": "number",
      "title": "Order",
      "description": "Sort order within a column",
      "default": 0
    }
  },
  "required": [
    "title",
    "stage"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": true,
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}